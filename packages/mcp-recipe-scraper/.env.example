# Copy to .env and fill in as needed, then run with:
#   uv run --env-file .env mcp-recipe-scraper
# See ../../README.md#proxying-outbound-requests for details.

# Route outbound requests through a web proxy (e.g. tinyproxy).
#MCP_PROXY_URL=http://tinyproxy-host:8888
#MCP_PROXY_USERNAME=myuser
#MCP_PROXY_PASSWORD=mypass
